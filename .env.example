# HONEYMOON API keys
# Copy this file to .env and fill in the keys for the providers you use.
# Keys are read by LiteLLM for model routing; only one provider is required.

# Default routing uses openai/gpt-5.4-mini
OPENAI_API_KEY=

# Optional: other providers supported through LiteLLM
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
